  "derivation": [
    "Pok\u00e9gear base = PKHeX caller offset 0xC0EC - primary caller-field offset 0x60C = 0xBAE0.",
    "Safari base = 0xBAE0 + aligned primary Pok\u00e9gear size 0x658 + save-substructure trailer 4 = 0xC13C.",
    "Dedicated HGSS editor independently supplies 0xC13C, 0x7A stride and 0xC418 counters.",
    "6 * (2 + 30 * 4) = 0x2DC bytes before the twelve area counters.",
    "Two 0x2E8-byte sets plus 0x28-byte link-leader data place pending days at +0x5F8 and the packed unlock/selection byte at +0x5F9.",
    "PKHeX event-variable base 0xDE4 + 2 * (0x4057 - 0x4000) = 0xE92."
  ],
